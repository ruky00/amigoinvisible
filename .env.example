# Copia este archivo como .env.local para cambiar la configuración en tu ordenador.

# true (por defecto) = usa el simulador que guarda en el navegador.
# false = llama a la API real (ver API.md).
VITE_USE_MOCK=true

# Solo si la API está en otro dominio. Vacío = mismo dominio que el front (/api).
VITE_API_URL=

# Copia este archivo como .env.local para cambiar la configuración en tu ordenador.
#
# Por defecto (sin .env.local) la app usa el simulador, que guarda todo en el navegador.
#
# Para usar la API de verdad (carpeta worker/, ver README.md):
#   1. Arranca la API: npm run db:migrate:local (la primera vez) y npx wrangler dev
#      (escucha en http://localhost:8787).
#   2. Crea .env.local con:  VITE_USE_MOCK=false
#   3. Arranca el front con  npm run dev
# Deja VITE_API_URL vacía: en `npm run dev` Vite reenvía /api a http://localhost:8787 (proxy
# configurado en vite.config.ts).

# true (por defecto) = usa el simulador que guarda en el navegador.
# false = llama a la API real (ver API.md).
VITE_USE_MOCK=true

# Solo si la API está en otro dominio (p. ej. en producción: https://api.midominio.com).
# Vacío = mismo dominio que el front (/api), o el proxy de Vite en desarrollo.
VITE_API_URL=

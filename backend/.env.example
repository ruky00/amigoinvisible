# Copia este fichero como .env (en esta misma carpeta backend/) y cambia lo que quieras.
# docker compose lo lee solo. El .env NO se sube a git.

# Contraseña de la zona de organización (/organizar). ¡Cámbiala fuera de tu ordenador!
ADMIN_PASSWORD=turron

# Base de datos PostgreSQL (la crea docker compose con estos datos)
DB_NAME=amigoinvisible
DB_USER=amigo
DB_PASSWORD=amigo
# Puerto de tu ordenador donde se publica PostgreSQL (cámbialo si ya tienes otro en 5432)
DB_PORT=5432

# Desde qué webs se puede llamar a la API (separadas por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true = carga los sorteos de ejemplo si la base de datos está vacía
DEMO_DATA=false
